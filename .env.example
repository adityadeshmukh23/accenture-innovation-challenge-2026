# Copy to .env to override. Every value below is the default; AEGIS runs
# fully offline with none of them set.

# mock   = deterministic seeded backend (default, offline, reproducible)
# openai = real OpenAI upstream           (requires OPENAI_API_KEY)
# groq   = real Groq-hosted upstream      (requires GROQ_API_KEY)
# Both live providers serve the OpenAI chat-completions wire format and share
# one client; only the endpoint, key variable and default model differ.
AEGIS_BACKEND=mock

# Global RNG seed. Fixed seed => byte-identical demo runs.
AEGIS_SEED=1337

# Where the audit ledger + feedback labels live.
AEGIS_DATA_DIR=./data

# Default policy applied when a request names no use case.
AEGIS_DEFAULT_POLICY=default

# Real-upstream settings (only read when AEGIS_BACKEND names a live provider).
# Each provider supplies its own defaults; set these only to override them.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# AEGIS_UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
# AEGIS_UPSTREAM_MODEL=openai/gpt-oss-120b
# AEGIS_VERIFIER_MODEL=openai/gpt-oss-120b
