.ruff_cache/

# --- Runtime data (regenerated by `make demo`) ------------------------------
# The audit ledger, its checkpoint sidecar, fitted models, captured feedback
# labels and the metrics snapshot are all produced by a run. The committed
# reference copy of the metrics lives at docs/reference_metrics.json.
data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.head.json

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json

# --- Editors / IDEs ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Agent / tooling scratch ------------------------------------------------
# Previously excluded only via .git/info/exclude, which is local and does not
# travel with a clone.
.claude/
.aider*

# --- Deck build artifacts ---------------------------------------------------
# scripts/deck/assemble.py unpacks the R1 template into scripts/deck/unpacked/
# and writes the built deck beside itself. The shipped deck is the copy under
# docs/; both of these are regenerable outputs.
scripts/deck/unpacked/
scripts/deck/*.pptx

# --- JS (none today; the dashboard is dependency-free vanilla JS) ------------
node_modules/
npm-debug.log*
yarn-error.log*

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
